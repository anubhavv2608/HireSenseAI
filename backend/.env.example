# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=5001

# MongoDB connection string (local instance or a managed service like MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/hiresense

# Secrets used to sign access/refresh JWTs — generate long random strings
# (e.g. `openssl rand -hex 64`) and never reuse the same value for both.
# In production these are required to be set to real, non-default values.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend origin allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# Google OAuth client ID (used to verify Google Sign-In tokens)
GOOGLE_CLIENT_ID=

# Cloudinary credentials (resume/file storage provider)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini API key (LLM provider for resume analysis, interview generation, etc.)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2

# Used only by the one-off `seedAdmin` script to create the first admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email provider: "resend" (default), "gmail", or "smtp"
RESEND_API_KEY=
EMAIL_FROM=HireSenseAI <onboarding@resend.dev>
EMAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
