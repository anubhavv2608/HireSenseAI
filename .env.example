# Copy to .env and fill in real values before running `docker compose up --build`.
# MongoDB is expected to be an external/managed instance (e.g. MongoDB Atlas) —
# docker-compose does not run a mongo container.

# --- Backend ---
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/hiresense
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.2
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=HireSenseAI <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Frontend (baked in at build time) ---
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_GOOGLE_CLIENT_ID=

# --- Host port mapping (optional overrides) ---
BACKEND_PORT=5001
FRONTEND_PORT=5173
